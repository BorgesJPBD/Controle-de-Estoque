# Copie este arquivo para ".env" e troque os valores antes de usar em produção.
# O docker compose lê o .env automaticamente.

# Gere uma chave com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=coloque-aqui-uma-chave-longa-e-aleatoria

# Senha do PostgreSQL. Atenção: ela só vale na PRIMEIRA vez que o banco é criado.
DB_PASSWORD=postgres123
